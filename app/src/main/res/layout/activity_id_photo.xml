<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/idPhotoRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Top Action Bar matching 功能参考2.jpg: Cancel on left, Save on right, NO top segmented toggle -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/black"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:text="@string/cancel"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/image_toolbox_id_photo"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:text="@string/editor_save"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="#F5C542"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center: Interactive Framing Surface -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="160dp">

        <org.lineageos.glimpse.ui.views.CropImageView
            android:id="@+id/cropImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay Badge: floating indicator of current spec details -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/specBadgeCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#99000000"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/specBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Bottom Controls Area matching 功能参考2.jpg: Fixed, Dark, Multi-layer -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#1C1C1E"
        android:orientation="vertical">

        <!-- CONTENT LAYER 1: Specs Mode (规格) -->
        <LinearLayout
            android:id="@+id/specsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <!-- Category Tabs Row with Search Icon on Left (as in 功能参考2.jpg) -->
            <LinearLayout
                android:id="@+id/categoryTabsRow"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageButton
                    android:id="@+id/searchButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/id_photo_all_specs"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_search"
                    app:tint="#8E8E93" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/categoryTabsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Preset Cards Rail with Expand Button on Left (as in 功能参考2.jpg) -->
            <LinearLayout
                android:id="@+id/presetRailRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <!-- Expand / All Specs square button (leftmost square button in 功能参考2.jpg) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/allSpecsExpandButton"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#2C2C2E"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#3A3A3C"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/id_photo_all_specs"
                        android:src="@drawable/ic_photo_size_select_actual"
                        app:tint="@android:color/white" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Scrollable Preset Cards (Selected card is #F5C542 gold with black text, inactive is #2C2C2E) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/presetRailRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never" />
            </LinearLayout>

        </LinearLayout>

        <!-- CONTENT LAYER 2: Background Colors Mode (背景) -->
        <LinearLayout
            android:id="@+id/backgroundContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <!-- Horizontal row of color swatches -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/backgroundColorRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:background="#2C2C2E" />

        <!-- BOTTOM-MOST TAB BAR: "规格" (Specs) and "背景" (Background) (as in 功能参考2.jpg) -->
        <LinearLayout
            android:id="@+id/bottomTabBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabSpecsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/id_photo_tab_spec"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="#F5C542"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabBackgroundButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/id_photo_tab_background"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="#8E8E93"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Full Catalog Picker Overlay (Tap-opened, Non-draggable) -->
    <LinearLayout
        android:id="@+id/catalogPickerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Overlay Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/id_photo_all_specs"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <ImageButton
                android:id="@+id/pickerCloseButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Group Tabs (ChipGroup) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/pickerGroupChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- 2-Column Preset Grid of all 32 presets -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pickerRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- Saving / Processing Overlay -->
    <FrameLayout
        android:id="@+id/savingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_media_viewer_bottom_sheet"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/id_photo_generating"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

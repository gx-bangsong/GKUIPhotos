<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/toolbox_title"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <!-- 1. Compress -->
    <LinearLayout
        android:id="@+id/compressSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/toolbox_compress"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            app:drawableStartCompat="@drawable/ic_compress" />

        <RadioGroup
            android:id="@+id/compressRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/compressHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/toolbox_compress_quality_high" />

            <RadioButton
                android:id="@+id/compressMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toolbox_compress_quality_medium" />

            <RadioButton
                android:id="@+id/compressLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toolbox_compress_quality_low" />

            <RadioButton
                android:id="@+id/compressMaxSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toolbox_compress_max_size" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/compressRunButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/toolbox_compress_run" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- 2. Convert format -->
    <LinearLayout
        android:id="@+id/convertSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/toolbox_convert"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            app:drawableStartCompat="@drawable/ic_convert" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/convertChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/convertRunButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/toolbox_convert_run" />
    </LinearLayout>

    <!-- 3. Video to GIF — HCI-redesigned: preview + range + fps + resolution -->
    <LinearLayout
        android:id="@+id/videoToGifSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/toolbox_video_to_gif"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            app:drawableStartCompat="@drawable/ic_video_to_gif" />

        <TextView
            android:id="@+id/gifVideoDurationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="视频总长：--"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/gifPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_thumbnail"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- 起始位置 -->
        <TextView
            android:id="@+id/gifStartLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="起始位置：0.0s"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <SeekBar
            android:id="@+id/gifStartSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0" />

        <!-- 截取时长 -->
        <TextView
            android:id="@+id/gifDurationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="截取时长：5s"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <SeekBar
            android:id="@+id/gifDurationSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="4" />

        <!-- 帧率 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="帧率（流畅度 vs 体积）"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/gifFpsChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />

        <!-- 分辨率 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="分辨率（清晰度 vs 体积）"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/gifResChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/gifEstimateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="预计：约 40 帧 · 约 2.1 MB"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gifPreviewButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="预览首帧" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/videoToGifRunButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/toolbox_video_to_gif_run" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. GIF editor entry (for animated GIFs) -->
    <LinearLayout
        android:id="@+id/gifEditorSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/gif_editor_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            app:drawableStartCompat="@drawable/ic_video_to_gif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="逐帧预览、变速、裁剪、旋转与滤镜，离线重编码"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gifEditorOpenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gif_editor_title" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/toolboxProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>

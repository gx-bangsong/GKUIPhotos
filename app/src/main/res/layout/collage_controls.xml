<?xml version="1.0" encoding="utf-8"?>
<!-- Shared mode-based collage editing panel for portrait and landscape.
     SPDX-FileCopyrightText: The LineageOS Project
     SPDX-License-Identifier: Apache-2.0 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    app:cardBackgroundColor="?attr/colorSurfaceContainer" app:cardCornerRadius="24dp"
    app:cardElevation="0dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingTop="12dp">
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/collageModes" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingHorizontal="16dp"
            app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/collageModePhoto">
            <com.google.android.material.button.MaterialButton android:id="@+id/collageModePhoto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/collage_mode_photos" />
            <com.google.android.material.button.MaterialButton android:id="@+id/collageModeLayout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/collage_layout_heading" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:fillViewport="false" android:fadeScrollbars="false"
            android:scrollbars="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:id="@+id/collagePhotoPanel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp" android:paddingTop="4dp" android:paddingBottom="6dp"
                        android:text="@string/collage_photos_heading" android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/collageFilmstrip"
                        android:layout_width="match_parent" android:layout_height="76dp"
                        android:clipToPadding="false" android:paddingHorizontal="20dp"
                        android:scrollbars="horizontal" android:fadeScrollbars="false" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:paddingHorizontal="20dp"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/collageZoomLabel" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/collage_zoom" android:labelFor="@id/collageZoom"
                            android:textAppearance="?attr/textAppearanceLabelLarge" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/collageReplace"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/collage_replace_photo" />
                    </LinearLayout>
                    <com.google.android.material.slider.Slider android:id="@+id/collageZoom"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp" android:layout_marginBottom="8dp"
                        android:valueFrom="1" android:valueTo="4" android:value="1" />
                </LinearLayout>
                <LinearLayout android:id="@+id/collageLayoutPanel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="12dp"
                        android:text="@string/collage_layout_prompt" android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:scrollbars="horizontal" android:fadeScrollbars="false"
                        android:fadingEdgeLength="20dp" android:requiresFadingEdge="horizontal">
                        <LinearLayout android:id="@+id/collageLayoutCards" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:orientation="horizontal"
                            android:paddingHorizontal="20dp" android:paddingBottom="16dp" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
